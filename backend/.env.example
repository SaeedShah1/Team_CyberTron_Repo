PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# Path to the JSON DB file (relative to backend/ root)
DATA_FILE=./data/db.json
LOG_FILE=./data/operations.log

# Session settings
SESSION_TIMEOUT_MINUTES=5
SESSION_SECRET=replace-with-a-random-string

# Bcrypt cost (lower = faster, fine for hackathon)
BCRYPT_ROUNDS=8
